diff --git a/script/preview_collapse_identical_open_periods.sql b/script/preview_collapse_identical_open_periods.sql
new file mode 100644
index 0000000..3d4ed45
--- /dev/null
+++ b/script/preview_collapse_identical_open_periods.sql
@@ -0,0 +1,76 @@
+-- READ ONLY. Preview for the 120 identical-duplicate collapse.
+-- Bruce signs this result set before any write.
+-- Same open period = same car + rider + start_date.
+-- Keep: filled assignment_id_ext, else latest moved_at, else latest id.
+-- Close: end_date = start_date (no deletes).
+-- Excludes cars 23602 and 23603. Does not list them.
+-- Snapshot of this query from production 2026-10-12 is
+-- script/preview_collapse_identical_open_periods.2026-10-12.csv
+
+WITH opens AS (
+  SELECT
+    ah.id,
+    ah.railcar_id,
+    ah.rider_external_id,
+    ah.start_date,
+    ah.assignment_id_ext,
+    ah.assignment_label,
+    ah.active,
+    ah.moved_at,
+    ah.comment,
+    r.reporting_marks,
+    r.car_number
+  FROM public.assignment_history ah
+  JOIN public.railcars r ON r.id = ah.railcar_id
+  WHERE r.active IS TRUE
+    AND r.id NOT IN (23602, 23603)
+    AND ah.end_date IS NULL
+),
+multi AS (
+  SELECT railcar_id
+  FROM opens
+  GROUP BY railcar_id
+  HAVING count(*) > 1
+),
+pairs AS (
+  SELECT o.*
+  FROM opens o
+  JOIN multi m ON m.railcar_id = o.railcar_id
+),
+identical_cars AS (
+  SELECT railcar_id
+  FROM pairs
+  GROUP BY railcar_id
+  HAVING count(DISTINCT concat_ws('|', coalesce(rider_external_id, ''), coalesce(start_date::text, ''))) = 1
+),
+ranked AS (
+  SELECT
+    p.*,
+    row_number() OVER (
+      PARTITION BY p.railcar_id
+      ORDER BY
+        (p.assignment_id_ext IS NOT NULL AND btrim(p.assignment_id_ext) <> '') DESC,
+        p.moved_at DESC NULLS LAST,
+        p.id DESC
+    ) AS keep_rank
+  FROM pairs p
+  JOIN identical_cars i ON i.railcar_id = p.railcar_id
+),
+keep AS (SELECT * FROM ranked WHERE keep_rank = 1),
+close AS (SELECT * FROM ranked WHERE keep_rank > 1)
+SELECT
+  k.railcar_id,
+  k.reporting_marks,
+  k.car_number,
+  k.rider_external_id,
+  k.start_date::text AS start_date,
+  k.id AS keep_id,
+  k.assignment_id_ext AS keep_assignment_id_ext,
+  k.moved_at AS keep_moved_at,
+  c.id AS close_id,
+  c.assignment_id_ext AS close_assignment_id_ext,
+  c.moved_at AS close_moved_at,
+  c.start_date::text AS close_end_date_will_be
+FROM keep k
+JOIN close c ON c.railcar_id = k.railcar_id
+ORDER BY k.reporting_marks, k.car_number;
diff --git a/script/preview_differing_open_periods_66.sql b/script/preview_differing_open_periods_66.sql
new file mode 100644
index 0000000..4d2e161
--- /dev/null
+++ b/script/preview_differing_open_periods_66.sql
@@ -0,0 +1,57 @@
+-- READ ONLY. Phase 2 review table — not approved to close.
+-- 66 active cars with more than one open period that differ on rider or start.
+-- Bruce signs this (plus the latest VCF current row) before anything closes.
+-- Excludes 23602 / 23603. File current columns are left for the latest workbook.
+
+WITH opens AS (
+  SELECT
+    ah.id,
+    ah.railcar_id,
+    ah.rider_external_id,
+    ah.start_date,
+    ah.assignment_id_ext,
+    ah.assignment_label,
+    ah.moved_at,
+    r.reporting_marks,
+    r.car_number,
+    r.rider_external_id AS car_rider
+  FROM public.assignment_history ah
+  JOIN public.railcars r ON r.id = ah.railcar_id
+  WHERE r.active IS TRUE
+    AND r.id NOT IN (23602, 23603)
+    AND ah.end_date IS NULL
+),
+multi AS (
+  SELECT railcar_id
+  FROM opens
+  GROUP BY railcar_id
+  HAVING count(*) > 1
+),
+pairs AS (
+  SELECT o.*
+  FROM opens o
+  JOIN multi m ON m.railcar_id = o.railcar_id
+),
+differing AS (
+  SELECT railcar_id
+  FROM pairs
+  GROUP BY railcar_id
+  HAVING count(DISTINCT concat_ws('|', coalesce(rider_external_id, ''), coalesce(start_date::text, ''))) > 1
+)
+SELECT
+  p.railcar_id,
+  p.reporting_marks,
+  p.car_number,
+  p.car_rider AS car_current_rider,
+  p.id AS history_id,
+  p.rider_external_id AS history_rider,
+  p.start_date,
+  p.assignment_id_ext,
+  p.assignment_label,
+  p.moved_at,
+  NULL::text AS file_current_rider,
+  NULL::text AS file_current_start,
+  NULL::text AS file_current_assignment_id
+FROM pairs p
+JOIN differing d ON d.railcar_id = p.railcar_id
+ORDER BY p.reporting_marks, p.car_number, p.start_date, p.id;
diff --git a/script/preview_phase1_test_queries.sql b/script/preview_phase1_test_queries.sql
new file mode 100644
index 0000000..de7907c
--- /dev/null
+++ b/script/preview_phase1_test_queries.sql
@@ -0,0 +1,64 @@
+-- Phase 1 test queries (read only). Run before and after the signed 120-collapse.
+-- Cars 23602 and 23603 are excluded from every cleanup count.
+
+-- 1. Status triad mismatch. Must stay 0.
+SELECT count(*) AS mismatch_rows
+FROM public.v_railcar_active_status_mismatch;
+
+-- 2. Active cars with more than one open assignment_history period.
+-- Before 120-collapse: 186. After 120-collapse: 66. After the 66 + importer: 0.
+SELECT count(*) AS active_cars_multi_open
+FROM (
+  SELECT ah.railcar_id
+  FROM public.assignment_history ah
+  JOIN public.railcars r ON r.id = ah.railcar_id
+  WHERE r.active IS TRUE
+    AND r.id NOT IN (23602, 23603)
+    AND ah.end_date IS NULL
+  GROUP BY ah.railcar_id
+  HAVING count(*) > 1
+) s;
+
+-- 3. Cursor test (c): exactly one open history period whose rider disagrees
+-- with railcar_assignments (exclude SOLD). Production 2026-10-12 = 5 TFOX
+-- OL1503-vs-EA1503 cars plus TEST 999012 if present. Claude's looser
+-- "lease is EA1503" match is a different set — see docs/VCF_CLOSEOUT_PHASE1.md.
+WITH one_open AS (
+  SELECT ah.railcar_id
+  FROM public.assignment_history ah
+  JOIN public.railcars r ON r.id = ah.railcar_id
+  WHERE r.active IS TRUE
+    AND r.id NOT IN (23602, 23603)
+    AND ah.end_date IS NULL
+  GROUP BY ah.railcar_id
+  HAVING count(*) = 1
+)
+SELECT
+  r.id,
+  r.reporting_marks,
+  r.car_number,
+  ah.rider_external_id AS hist_rider,
+  ra.sub_lease_number,
+  rd.rider_name
+FROM one_open o
+JOIN public.railcars r ON r.id = o.railcar_id
+JOIN public.assignment_history ah
+  ON ah.railcar_id = r.id AND ah.end_date IS NULL
+JOIN public.railcar_assignments ra ON ra.id::text = r.current_assignment_id
+LEFT JOIN public.riders rd ON rd.id = ra.rider_id
+WHERE coalesce(ah.rider_external_id, '') <> 'SOLD'
+  AND coalesce(ra.sub_lease_number, '') <> 'SOLD'
+  AND coalesce(rd.rider_name, '') <> 'SOLD'
+  AND coalesce(ah.rider_external_id, '')
+        IS DISTINCT FROM coalesce(rd.rider_name, ra.sub_lease_number, '')
+  AND coalesce(ah.rider_external_id, '')
+        IS DISTINCT FROM coalesce(ra.sub_lease_number, '')
+ORDER BY r.reporting_marks, r.car_number;
+
+-- 4. Confirm the VCF natural-key unique index is still absent (repo file
+-- migrations/20260813_vcf_history_natural_keys.sql was never applied).
+SELECT indexname
+FROM pg_indexes
+WHERE schemaname = 'public'
+  AND tablename = 'assignment_history'
+ORDER BY indexname;
