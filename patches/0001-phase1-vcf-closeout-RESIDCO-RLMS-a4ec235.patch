@@ -0,0 +1,36 @@
+-- Derive railcars.active and railcars.active_status from railcars.status.
+-- Phase 1 (Bruce 2026-10-12): status is the authority.
+--   status = 'Active/In-Service' → active true, active_status 'Active'
+--   any other non-blank status  → active false, active_status 'Inactive'
+-- Does NOT derive fleet_status (Leased / Idle / Sold / Abatement stays independent).
+-- Columns remain writable so remark_railcars and VCF keep sending the triad;
+-- this trigger overwrites the derived pair from status on the same write.
+-- File only in this PR — do not apply to production until the Phase 1 deploy.
+
+CREATE OR REPLACE FUNCTION public.railcars_derive_active_from_status()
+RETURNS trigger
+LANGUAGE plpgsql
+AS $$
+BEGIN
+  IF NEW.status IS NULL OR btrim(NEW.status) = '' THEN
+    RETURN NEW;
+  END IF;
+  IF btrim(NEW.status) = 'Active/In-Service' THEN
+    NEW.active := true;
+    NEW.active_status := 'Active';
+  ELSE
+    NEW.active := false;
+    NEW.active_status := 'Inactive';
+  END IF;
+  RETURN NEW;
+END;
+$$;
+
+DROP TRIGGER IF EXISTS trg_railcars_derive_active_from_status ON public.railcars;
+CREATE TRIGGER trg_railcars_derive_active_from_status
+  BEFORE INSERT OR UPDATE OF status, active, active_status ON public.railcars
+  FOR EACH ROW
+  EXECUTE FUNCTION public.railcars_derive_active_from_status();
+
+COMMENT ON FUNCTION public.railcars_derive_active_from_status() IS
+  'Keep railcars.active / active_status aligned with status. Does not touch fleet_status. Rollback: DROP TRIGGER trg_railcars_derive_active_from_status ON public.railcars; DROP FUNCTION public.railcars_derive_active_from_status();';
diff --git a/script/apply_collapse_identical_open_periods.sql b/script/apply_collapse_identical_open_periods.sql
new file mode 100644
index 0000000..4998816
--- /dev/null
+++ b/script/apply_collapse_identical_open_periods.sql
@@ -0,0 +1,87 @@
+-- DO NOT RUN until Bruce signs script/preview_collapse_identical_open_periods.sql.
+-- This file raises on purpose. Remove the guard block below only after sign-off.
+-- One transaction. No deletes. Excludes 23602 / 23603.
+-- Sets end_date = start_date, active = false, and a comment on the close row.
+-- Rollback: script/rollback_collapse_identical_open_periods.sql using the
+-- close_id list saved from the signed preview.
+
+DO $$
+BEGIN
+  RAISE EXCEPTION
+    'Blocked: apply only after Bruce signs the 120-collapse preview. Remove this guard to run.';
+END
+$$;
+
+BEGIN;
+
+WITH opens AS (
+  SELECT
+    ah.id,
+    ah.railcar_id,
+    ah.rider_external_id,
+    ah.start_date,
+    ah.assignment_id_ext,
+    ah.moved_at,
+    ah.comment
+  FROM public.assignment_history ah
+  JOIN public.railcars r ON r.id = ah.railcar_id
+  WHERE r.active IS TRUE
+    AND r.id NOT IN (23602, 23603)
+    AND ah.end_date IS NULL
+),
+multi AS (
+  SELECT railcar_id
+  FROM opens
+  GROUP BY railcar_id
+  HAVING count(*) > 1
+),
+pairs AS (
+  SELECT o.*
+  FROM opens o
+  JOIN multi m ON m.railcar_id = o.railcar_id
+),
+identical_cars AS (
+  SELECT railcar_id
+  FROM pairs
+  GROUP BY railcar_id
+  HAVING count(DISTINCT concat_ws('|', coalesce(rider_external_id, ''), coalesce(start_date::text, ''))) = 1
+),
+ranked AS (
+  SELECT
+    p.*,
+    row_number() OVER (
+      PARTITION BY p.railcar_id
+      ORDER BY
+        (p.assignment_id_ext IS NOT NULL AND btrim(p.assignment_id_ext) <> '') DESC,
+        p.moved_at DESC NULLS LAST,
+        p.id DESC
+    ) AS keep_rank
+  FROM pairs p
+  JOIN identical_cars i ON i.railcar_id = p.railcar_id
+),
+to_close AS (
+  SELECT id, start_date, comment
+  FROM ranked
+  WHERE keep_rank > 1
+)
+UPDATE public.assignment_history ah
+SET
+  end_date = to_close.start_date,
+  active = false,
+  comment = CASE
+    WHEN coalesce(btrim(to_close.comment), '') = '' THEN
+      'VCF close-out: collapsed duplicate open period (same rider+start)'
+    WHEN to_close.comment LIKE '%collapsed duplicate open period%' THEN
+      to_close.comment
+    ELSE
+      to_close.comment || ' | VCF close-out: collapsed duplicate open period (same rider+start)'
+  END
+FROM to_close
+WHERE ah.id = to_close.id
+  AND ah.end_date IS NULL
+  AND ah.railcar_id NOT IN (23602, 23603)
+RETURNING ah.id AS closed_id, ah.railcar_id, ah.end_date;
+
+-- Re-run Phase 1 test queries (script/preview_phase1_test_queries.sql) before COMMIT.
+-- COMMIT;
+-- ROLLBACK;
